{
  "_comment": "Grafana dashboard skeleton for Mockstar. Each panel traces to a constraint; import into Grafana and adjust data source UIDs as needed.",
  "title": "Mockstar",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Request throughput by tenant (O2)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (tenant) (rate(mockstar_requests_total[1m]))" }
      ]
    },
    {
      "id": 2,
      "title": "Request latency p50 / p99 (RT-6, T3)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(mockstar_request_latency_us_bucket[5m])))", "legendFormat": "p50 us" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(mockstar_request_latency_us_bucket[5m])))", "legendFormat": "p99 us" }
      ]
    },
    {
      "id": 3,
      "title": "Match rate (matched vs. 404) (U1)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (matched) (rate(mockstar_requests_total[1m]))" }
      ]
    },
    {
      "id": 4,
      "title": "Journal utilisation per tenant (O3)",
      "type": "timeseries",
      "targets": [
        { "expr": "mockstar_journal_size" }
      ]
    },
    {
      "id": 5,
      "title": "Process faults (RT-3)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(mockstar_process_faults_total[5m])) by (kind)" }
      ]
    }
  ]
}
