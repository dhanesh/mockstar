{
  "mocks": [
    {
      "id": "get-user-by-id",
      "match": { "method": "GET", "path": "/users/:id" },
      "response": {
        "kind": "static",
        "status": 200,
        "headers": { "content-type": "application/json" },
        "body": {
          "id": "{{request.params.id}}",
          "uuid": "{{faker.uuid}}",
          "name": "{{faker.name}}",
          "email": "{{faker.email}}",
          "tenant": "{{tenant}}"
        }
      },
      "scenarios": [
        {
          "id": "not-found",
          "when": { "params": { "id": "not-found" } },
          "response": {
            "status": 404,
            "body": { "error": "user_not_found", "id": "not-found" }
          }
        },
        {
          "id": "suspended",
          "when": { "params": { "id": "suspended" } },
          "response": {
            "status": 403,
            "body": { "error": "account_suspended", "id": "suspended" }
          }
        },
        {
          "id": "guest-forbidden",
          "when": { "headers": { "x-role": "guest" } },
          "response": {
            "status": 403,
            "body": { "error": "insufficient_permissions" }
          }
        }
      ]
    },
    {
      "id": "create-user",
      "match": { "method": "POST", "path": "/users" },
      "response": {
        "kind": "static",
        "status": 201,
        "headers": { "content-type": "application/json" },
        "body": {
          "id": "{{faker.uuid}}",
          "created": "{{faker.dateIso}}",
          "echoBody": "{{request.body.name}}"
        }
      },
      "scenarios": [
        {
          "id": "blocked-email-domain",
          "when": { "body": { "email": { "contains": "@blocked.com" } } },
          "response": {
            "status": 422,
            "body": { "error": "blocked_email_domain", "field": "email" }
          }
        },
        {
          "id": "admin-role-forbidden",
          "when": { "body": { "role": "admin" } },
          "response": {
            "status": 403,
            "body": { "error": "insufficient_permissions", "field": "role" }
          }
        }
      ]
    }
  ]
}
