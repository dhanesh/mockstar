{
  "mocks": [
    {
      "id": "get-user",
      "match": { "method": "GET", "path": "/users/:username", "priority": 10 },
      "response": {
        "kind": "static",
        "status": 200,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "x-github-media-type": "github.v3; format=json",
          "x-ratelimit-limit": "60",
          "x-ratelimit-remaining": "59",
          "x-ratelimit-resource": "core"
        },
        "body": {
          "login": "{{request.params.username}}",
          "id": "{{faker.integer(1, 9999999)}}",
          "node_id": "MDQ6VXNlcjE=",
          "avatar_url": "https://avatars.githubusercontent.com/u/1?v=4",
          "gravatar_id": "",
          "url": "https://api.github.com/users/{{request.params.username}}",
          "html_url": "https://github.com/{{request.params.username}}",
          "followers_url": "https://api.github.com/users/{{request.params.username}}/followers",
          "following_url": "https://api.github.com/users/{{request.params.username}}/following{/other_user}",
          "gists_url": "https://api.github.com/users/{{request.params.username}}/gists{/gist_id}",
          "starred_url": "https://api.github.com/users/{{request.params.username}}/starred{/owner}{/repo}",
          "subscriptions_url": "https://api.github.com/users/{{request.params.username}}/subscriptions",
          "organizations_url": "https://api.github.com/users/{{request.params.username}}/orgs",
          "repos_url": "https://api.github.com/users/{{request.params.username}}/repos",
          "events_url": "https://api.github.com/users/{{request.params.username}}/events{/privacy}",
          "received_events_url": "https://api.github.com/users/{{request.params.username}}/received_events",
          "type": "User",
          "user_view_type": "public",
          "site_admin": false,
          "name": "{{faker.name}}",
          "company": null,
          "blog": "",
          "location": "{{faker.pick([\"San Francisco, CA\", \"London, UK\", \"Berlin, DE\", \"Tokyo, JP\", \"Portland, OR\"])}}",
          "email": null,
          "hireable": null,
          "bio": null,
          "twitter_username": null,
          "public_repos": "{{faker.integer(1, 200)}}",
          "public_gists": "{{faker.integer(0, 50)}}",
          "followers": "{{faker.integer(0, 5000)}}",
          "following": "{{faker.integer(0, 200)}}",
          "created_at": "2018-04-10T12:00:00Z",
          "updated_at": "{{faker.dateIso}}"
        }
      }
    }
  ]
}
