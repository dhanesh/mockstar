{
  "name": "mockstar",
  "version": "0.1.0-alpha.1",
  "description": "Bun-based mock server with static + dynamic mocking, JSON config, named JS handlers, pass-through, multi-tenancy, and test-data utilities.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mockstar": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts ./examples/mocks",
    "build": "bun build src/index.ts src/cli.ts --outdir dist --target bun --format esm",
    "build:binary": "bun build src/cli.ts --compile --outfile dist/mockstar",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "bench": "bun run bench/harness.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome check src tests bench",
    "format": "bunx @biomejs/biome format --write src tests bench"
  },
  "keywords": [
    "mock",
    "mock-server",
    "api-mocking",
    "bun",
    "testing",
    "wiremock-alternative",
    "mockoon-alternative"
  ],
  "engines": {
    "bun": ">=1.1.8"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "hono": "^4.6.0",
    "jsonpath-plus": "^10.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
